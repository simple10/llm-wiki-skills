{
  "keywords": [
    "notion",
    "task",
    "tasks",
    "todo",
    "workspace"
  ],
  "kind": "channel",
  "name": "channel-notion-tasks",
  "requires": {
    "credential": false,
    "ops": ">=0.1.0"
  },
  "stages": {
    "harvest": {
      "sandbox_ref": "simple10/llm-wiki-skills:notion-tasks/notion-tasks.harvest"
    },
    "process": {}
  },
  "usage": "/channel-notion-tasks ticket=<id>",
  "v": 1,
  "venue": "notion-tasks",
  "version": "0.1.0",
  "watch": {
    "defaults": {
      "every": "1d"
    },
    "dest": "research/channels/{slug}",
    "inputs": {
      "workspace": {
        "prompt": "Which Notion workspace does this watch pull?",
        "required": true
      }
    },
    "note": "The connector is session-level on the pulling machine and is named nowhere in this unit \u2014 it is an MCP tool whose name depends on which client the machine runs. One watch per workspace."
  }
}
