{
  "keywords": [
    "frame",
    "share",
    "guest",
    "video",
    "assets",
    "deck"
  ],
  "kind": "channel",
  "name": "channel-frameio",
  "requires": {
    "credential": false,
    "network": [
      "*.frame.io",
      "frame.io"
    ],
    "ops": ">=1.88"
  },
  "stages": [
    "harvest",
    "process"
  ],
  "usage": "/channel-frameio ticket=<id> stage=harvest|process",
  "v": 2,
  "venue": "frameio",
  "version": "1.16.0",
  "watch": {
    "defaults": {
      "every": "once",
      "harvest": {
        "scope": "domain"
      }
    },
    "dest": "sources/courses/{slug}",
    "note": "`harvest.scope: domain` is MANDATORY: a share's leaves sit under the share host, not under the job's url, so `page` excludes all of them, and `section` does too whenever the url is a folder inside the share rather than its root."
  }
}
