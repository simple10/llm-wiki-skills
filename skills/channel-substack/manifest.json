{
  "keywords": [
    "newsletter",
    "newsletters",
    "archive",
    "posts",
    "paywall"
  ],
  "kind": "channel",
  "name": "channel-substack",
  "requires": {
    "credential": false,
    "network": [
      "*.substack.com",
      "substack.com",
      "substackcdn.com"
    ],
    "ops": ">=1.96.0"
  },
  "stages": [
    "harvest",
    "process"
  ],
  "usage": "/channel-substack ticket=<id> stage=harvest|process",
  "v": 2,
  "venue": "substack",
  "version": "1.12.0",
  "watch": {
    "defaults": {
      "every": "1d",
      "harvest": {
        "scope": "domain"
      }
    },
    "dest": "sources/newsletters/{slug}",
    "note": "Point it at the archive URL. `harvest.max_age` and `harvest.access` (free|licensed) are the operator's call."
  }
}
