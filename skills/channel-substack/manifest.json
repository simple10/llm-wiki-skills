{
  "keywords": [
    "newsletter",
    "newsletters",
    "archive",
    "posts",
    "paywall",
    "host:substack.com",
    "host:*.substack.com"
  ],
  "kind": "channel",
  "name": "channel-substack",
  "requires": {
    "credential": false,
    "ops": ">=1.96.0"
  },
  "stages": {
    "harvest": {
      "sandbox_ref": "simple10/llm-wiki-skills:substack/substack.harvest"
    },
    "process": {}
  },
  "usage": "/channel-substack ticket=<id> stage=harvest|process",
  "v": 2,
  "venue": "substack",
  "version": "1.13.0",
  "watch": {
    "defaults": {
      "every": "1d",
      "harvest": {
        "scope": "domain"
      }
    },
    "dest": "sources/newsletters/{slug}",
    "note": "Point it at the archive URL. `harvest.max_age` and `harvest.access` (free|licensed) are the operator's call."
  }
}
