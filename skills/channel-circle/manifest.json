{
  "keywords": [
    "community",
    "course",
    "courses",
    "lesson",
    "lessons",
    "space"
  ],
  "kind": "channel",
  "name": "channel-circle",
  "requires": {
    "credential": false,
    "network": [
      "*.circle.so",
      "circle.so"
    ],
    "ops": ">=1.88"
  },
  "stages": [
    "harvest"
  ],
  "v": 2,
  "venue": "circle",
  "version": "1.8.0",
  "watch": {
    "defaults": {
      "every": "once",
      "harvest": {
        "access": "licensed",
        "scope": "section"
      }
    },
    "dest": "sources/courses/{slug}",
    "note": "The URL must be the space ROOT (/c/<slug>): `harvest.scope: section` means under the job's own url, so from a lesson URL every sibling lesson is outside it."
  }
}
