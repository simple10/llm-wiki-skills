{
  "keywords": [
    "community",
    "course",
    "courses",
    "lesson",
    "lessons",
    "space",
    "host:circle.so",
    "host:*.circle.so"
  ],
  "kind": "channel",
  "name": "channel-circle",
  "requires": {
    "credential": false,
    "ops": ">=1.96.0"
  },
  "stages": {
    "harvest": {
      "sandbox_ref": "simple10/llm-wiki-skills:circle/circle.harvest"
    },
    "process": {}
  },
  "usage": "/channel-circle ticket=<id> stage=harvest|process",
  "v": 2,
  "venue": "circle",
  "version": "1.12.0",
  "watch": {
    "defaults": {
      "every": "once",
      "harvest": {
        "access": "licensed",
        "scope": "section",
        "assets": "download"
      }
    },
    "dest": "sources/courses/{slug}",
    "note": "The URL must be the space ROOT (/c/<slug>): `harvest.scope: section` means under the job's own url, so from a lesson URL every sibling lesson is outside it."
  }
}
