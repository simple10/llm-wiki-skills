{
  "keywords": [
    "video",
    "videos",
    "channel",
    "playlist",
    "captions",
    "transcript",
    "host:youtube.com",
    "host:*.youtube.com",
    "host:youtu.be"
  ],
  "kind": "channel",
  "name": "channel-youtube",
  "requires": {
    "bins": [
      {
        "bin": "yt-dlp",
        "source": "https://github.com/yt-dlp/yt-dlp",
        "installers": {
          "brew": "yt-dlp",
          "pip": "yt-dlp"
        }
      }
    ],
    "credential": false,
    "ops": ">=0.1.0"
  },
  "stages": {
    "harvest": {
      "sandbox_ref": "simple10/llm-wiki-skills:youtube/youtube.harvest"
    },
    "process": {}
  },
  "usage": "/channel-youtube ticket=<id>",
  "v": 1,
  "venue": "youtube",
  "version": "0.1.0",
  "watch": {
    "defaults": {
      "every": "once",
      "harvest": {
        "assets": "reference",
        "scope": "page"
      }
    },
    "dest": "sources/youtube/{slug}",
    "note": "Single videos are the proven shape; channel/playlist enumeration is untested (see the SKILL.md's Discovery)."
  }
}
