{
  "keywords": [
    "video",
    "videos",
    "channel",
    "playlist",
    "captions",
    "transcript"
  ],
  "kind": "channel",
  "name": "channel-youtube",
  "requires": {
    "bins": [
      {
        "bin": "yt-dlp",
        "source": "https://github.com/yt-dlp/yt-dlp",
        "installers": {
          "brew": "yt-dlp",
          "pip": "yt-dlp"
        }
      }
    ],
    "credential": false,
    "network": [
      "*.youtube.com",
      "youtube.com",
      "youtu.be",
      "*.googlevideo.com",
      "*.ytimg.com"
    ],
    "ops": ">=1.96.0"
  },
  "stages": [
    "harvest",
    "process"
  ],
  "usage": "/channel-youtube ticket=<id> stage=harvest|process",
  "v": 2,
  "venue": "youtube",
  "version": "1.13.0",
  "watch": {
    "defaults": {
      "every": "once",
      "harvest": {
        "assets": "reference",
        "scope": "page"
      }
    },
    "dest": "sources/youtube/{slug}",
    "note": "Single videos are the proven shape; channel/playlist enumeration is untested (see the SKILL.md's Discovery)."
  }
}
