{
  "kind": "channel",
  "match": {
    "hosts": [
      "youtube.com",
      "youtu.be"
    ]
  },
  "name": "channel-youtube",
  "process_entry": "scripts/youtube_note.py",
  "requires": {
    "credential": false,
    "network": [
      "*.youtube.com",
      "youtube.com",
      "youtu.be",
      "*.googlevideo.com",
      "*.ytimg.com"
    ],
    "ops": ">=1.2"
  },
  "stages": [
    "harvest",
    "process"
  ],
  "v": 2,
  "venue": "youtube",
  "version": "1.10.2",
  "watch": {
    "defaults": {
      "harvest": {
        "scope": "page"
      },
      "pipeline": {
        "assets": "reference"
      },
      "schedule": {
        "mode": "once"
      }
    },
    "dirs": {
      "sources": "sources/youtube/{slug}"
    },
    "note": "Single videos are the proven shape; channel/playlist enumeration is untested (see the SKILL.md's Discovery)."
  }
}
